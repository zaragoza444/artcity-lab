# Database
DATABASE_URL=postgresql+psycopg://artcity:artcity_local@localhost:5432/artcity

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=artcity_minio
MINIO_SECRET_KEY=artcity_minio_secret
MINIO_BUCKET=art-city-assets
MINIO_SECURE=false

# App
SECRET_KEY=change-me-local-dev-secret
# Art City only — never blockchainsystem.com / Nova / Alltra origins
CORS_ORIGINS=http://localhost:3000,https://frontend-production-6380.up.railway.app
PUBLIC_APP_URL=https://frontend-production-6380.up.railway.app
PUBLIC_API_URL=https://backend-production-9533.up.railway.app
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
AUTH_REQUIRED=true
EXTERNAL_PROVIDERS_ENABLED=true
DEFAULT_ADMIN_EMAIL=admin@artcity.ai
DEFAULT_ADMIN_PASSWORD=ArtCityAdmin!2026

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_DOCS_URL=http://localhost:8000/docs

# Production (Railway / cloud) — Art City domains only
# DATABASE_URL is injected by Railway Postgres
# REDIS_URL is injected by Railway Redis
# MINIO_* maps to Railway bucket S3 credentials
# CORS_ORIGINS=https://frontend-production-6380.up.railway.app
# NEXT_PUBLIC_API_URL=https://backend-production-9533.up.railway.app
# SECRET_KEY=generate-a-long-random-secret

# Optional cloud generation (used when set; Art City PNG/MP4/WAV masters always fall back)
# EXTERNAL_PROVIDERS_ENABLED=true
FAL_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Art City Edit (optional Stripe; invoice activation always available)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SIGNUP_EXPOSE_CODES=true
SIGNUP_REQUIRE_PHONE=true
SIGNUP_REQUIRE_EMAIL_VERIFY=true
SIGNUP_REQUIRE_PHONE_VERIFY=true

# AC Communications — placeholders only. Do not put live tokens in git.
META_APP_ID=
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
GRAPH_API_VERSION=v23.0
PROVIDER_KIND=direct_meta
COMM_LIVE_SEND_ENABLED=false
COMM_DEFAULT_TIMEZONE=Asia/Baghdad
COMM_QUIET_HOURS_START=21:00
COMM_QUIET_HOURS_END=09:00
COMM_DEFAULT_MAX_SPEND_USD=100.00
COMM_SEND_WORKER_INITIAL_MPS=1
COMM_ALLOW_UNVERIFIED_CONSENT=false
COMM_REQUIRE_SEPARATE_APPROVAL=true
COMM_REQUIRE_VALID_WEBHOOK_SIGNATURE=true
COMM_ENABLE_UNKNOWN_OUTCOME_AUTO_RETRY=false
COMM_PROCESS_INLINE=true
