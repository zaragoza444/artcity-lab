# Database
DATABASE_URL=postgresql+psycopg://artcity:artcity_local@localhost:5432/artcity

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=artcity_minio
MINIO_SECRET_KEY=artcity_minio_secret
MINIO_BUCKET=art-city-assets
MINIO_SECURE=false

# App
SECRET_KEY=change-me-local-dev-secret
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
AUTH_REQUIRED=true
EXTERNAL_PROVIDERS_ENABLED=true
DEFAULT_ADMIN_EMAIL=admin@artcity.ai
DEFAULT_ADMIN_PASSWORD=ArtCityAdmin!2026

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Railway / cloud)
# DATABASE_URL is injected by Railway Postgres
# REDIS_URL is injected by Railway Redis
# MINIO_* maps to Railway bucket S3 credentials
# CORS_ORIGINS=https://your-frontend.up.railway.app
# SECRET_KEY=generate-a-long-random-secret

# Optional AI provider keys (unused by stub provider)
FAL_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
